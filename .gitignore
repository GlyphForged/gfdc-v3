############################

# Compiled binaries
*.exe
*.dll
*.so
*.dylib

# Go test binaries & coverage
*.test
*.out

# Build output directories
bin/
build/
dist/

############################
# Go tooling / workspace
############################

# Go workspace files
go.work
go.work.sum

# Module cache / vendoring
pkg/
vendor/

# Debug binaries
__debug_bin

############################
# Logs & runtime data
############################

# Application logs
*.log
logs/
log/

# Runtime temp data
tmp/
temp/
*.tmp

############################
# Environment & secrets
############################

# Env files
.env
.env.*
!.env.example

# TLS / secrets
*.pem
*.key
*.crt

############################
